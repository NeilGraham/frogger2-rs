<?xml version="1.0" encoding="utf-8"?>
<!-- Swampy's Revenge Recomp (Frogger 2 engine recomp) for Android. Built by tools/android/build-apk.sh (no Gradle): aapt2 links
     this manifest, the Java activity (java/) is compiled with javac + d8, and the native
     library libfrogger_android.so comes from crates/frogger-android (cargo-ndk). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.neilgraham.swampysrevengerecomp"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- wgpu needs Vulkan or OpenGL ES 3.0 (its GLES backend). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Online play (docs/NETPLAY.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Swampy's Revenge Recomp"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:hasFragileUserData="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="frogger_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
